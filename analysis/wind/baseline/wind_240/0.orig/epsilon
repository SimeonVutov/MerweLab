FoamFile
{
    version         2;
    format          ascii;
    class           volScalarField;
    object          epsilon;
}

epsilonInlet    0.121485;

dimensions      [ 0 2 -3 0 0 0 0 ];

internalField   uniform 0.121485;

boundaryField
{
    inlet
    {
        type            atmBoundaryLayerInletEpsilon;
        flowDir         ( 1 0 0 );
        zDir            ( 0 0 1 );
        Uref            16;
        Zref            60;
        z0              uniform 0.7;
        d               uniform 0;
        kappa           0.4;
        Cmu             0.09;
        C1              0;
        C2              1;
        initABL         true;
        value           uniform 0.121485;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 0.121485;
        value           uniform 0.121485;
    }
    wall
    {
        type            epsilonWallFunction;
        value           uniform 0.121485;
    }
    cyclic
    {
        type            cyclic;
    }
    cyclicAMI
    {
        type            cyclicAMI;
        value           uniform 0.121485;
    }
    cyclicACMI
    {
        type            cyclicACMI;
        value           uniform 0.121485;
    }
    cyclicSlip
    {
        type            cyclicSlip;
    }
    empty
    {
        type            empty;
    }
    nonuniformTransformCyclic
    {
        type            nonuniformTransformCyclic;
    }
    processor
    {
        type            processor;
    }
    processorCyclic
    {
        type            processorCyclic;
    }
    symmetryPlane
    {
        type            symmetryPlane;
    }
    symmetry
    {
        type            symmetry;
    }
    wedge
    {
        type            wedge;
    }
    overset
    {
        type            overset;
    }
    terrain_water
    {
        type            atmEpsilonWallFunction;
        z0              uniform 0.0002;
        Cmu             0.09;
        kappa           0.4;
        value           uniform 0;
    }
    terrain_outer_water
    {
        type            atmEpsilonWallFunction;
        z0              uniform 0.0002;
        Cmu             0.09;
        kappa           0.4;
        value           uniform 0;
    }
    terrain_peninsula_paved
    {
        type            atmEpsilonWallFunction;
        z0              uniform 0.0002;
        Cmu             0.09;
        kappa           0.4;
        value           uniform 0;
    }
    terrain_peninsula_green
    {
        type            atmEpsilonWallFunction;
        z0              uniform 0.03;
        Cmu             0.09;
        kappa           0.4;
        value           uniform 0;
    }
    terrain_context_land
    {
        type            atmEpsilonWallFunction;
        z0              uniform 0.005;
        Cmu             0.09;
        kappa           0.4;
        value           uniform 0;
    }
    terrain_peninsula_ground
    {
        type            atmEpsilonWallFunction;
        z0              uniform 0.005;
        Cmu             0.09;
        kappa           0.4;
        value           uniform 0;
    }
    terrain_existing_platform_rim
    {
        type            atmEpsilonWallFunction;
        z0              uniform 0.005;
        Cmu             0.09;
        kappa           0.4;
        value           uniform 0;
    }

    #include "include/mappedWalls_epsilon"
}


