// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}

application     simpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         100;

deltaT          1;

writeControl    timeStep;

writeInterval   50;

purgeWrite      3;

writeFormat     binary;

writePrecision  10;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

functions
{
    solverHistory
    {
        type            solverInfo;
        libs            ( utilityFunctionObjects );
        fields          ( p U k epsilon );
        writeResidualFields false;
        executeControl  timeStep;
        executeInterval 1;
        writeControl    timeStep;
        writeInterval   1;
    }
    pedestrianProbes
    {
        type            probes;
        libs            ( sampling );
        fields          ( U k );
        interpolationScheme cellPoint;
        fixedLocations  true;
        includeOutOfBounds true;
        writeControl    timeStep;
        writeInterval   10;
        probeLocations  ( ( -1.35592 -4.66078 4.64 ) ( 186.799 31.2662 4.64 ) ( -144.169 -115.14 3.51741 ) ( 74.2937 109.778 4.61137 ) ( -118.369 5.209 4.64 ) ( 96.6513 -8.12367 4.64 ) ( -52.0213 -86.9327 4.64 ) ( 4.98 72.7827 4.64 ) ( -56.78 38.44 4.64 ) ( 124.881 62.5003 4.64 ) ( -111.499 -59.1857 4.64 ) ( 62.2797 45.565 4.64 ) ( -59.8547 -25.258 4.64 ) ( 46.2403 -34.7653 4.64 ) ( -4.14333 -60.501 4.64 ) ( 139.506 15.5733 4.64 ) );
    }
    yPlusMonitor
    {
        type            yPlus;
        libs            ( fieldFunctionObjects );
        executeControl  timeStep;
        executeInterval 100;
        writeControl    writeTime;
    }
    pedestrianSurfaces
    {
        type            surfaces;
        libs            ( sampling );
        writeControl    writeTime;
        surfaceFormat   vtk;
        interpolationScheme cellPoint;
        fields          ( U k p );
        surfaces
        {
            pedestrian1p5m
            {
                type            meshedSurface;
                surface         pedestrian_1p5m.obj;
                source          insideCells;
                interpolate     true;
            }
        }
    }
    flux_inlet
    {
        type            surfaceFieldValue;
        libs            ( fieldFunctionObjects );
        regionType      patch;
        name            inlet;
        operation       sum;
        fields          ( phi );
        writeFields     false;
        writeControl    timeStep;
        writeInterval   10;
    }
    flux_outlet
    {
        type            surfaceFieldValue;
        libs            ( fieldFunctionObjects );
        regionType      patch;
        name            outlet;
        operation       sum;
        fields          ( phi );
        writeFields     false;
        writeControl    timeStep;
        writeInterval   10;
    }
    flux_frontAndBack
    {
        type            surfaceFieldValue;
        libs            ( fieldFunctionObjects );
        regionType      patch;
        name            frontAndBack;
        operation       sum;
        fields          ( phi );
        writeFields     false;
        writeControl    timeStep;
        writeInterval   10;
    }
}

adjustTimeStep  false;


